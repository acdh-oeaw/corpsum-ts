{
	"name": "@acdh-oeaw/corpsum-ts",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"analyze": "nuxt analyze",
		"build": "nuxt build --dotenv local.env",
		"clean": "nuxt cleanup",
		"db:dump": "node scripts/dump-mongodb.ts",
		"db:migrate": "node scripts/migrate.ts",
		"dev": "nuxt dev --dotenv local.env",
		"format:check": "oxfmt --check",
		"format:fix": "oxfmt --write",
		"generate": "nuxt generate --dotenv local.env",
		"generate:noske-api": "node scripts/generate-noske-bonito-spec.ts && npx openapi-typescript ./public/noske.json -o ./lib/noske-types.d.ts",
		"generate:noske-bonito-api-spec": "node scripts/generate-noske-bonito-spec.ts",
		"github:env:sync": "node scripts/sync-github-environment.ts",
		"lint:check": "run-p --continue-on-error \"lint:*:check\"",
		"lint:code:check": "oxlint",
		"lint:code:fix": "oxlint --fix",
		"lint:fix": "run-p --continue-on-error \"lint:*:fix\"",
		"lint:styles:check": "stylelint \"./**/*.@(css|vue)\" --cache --ignore-path ./.gitignore",
		"lint:styles:fix": "stylelint \"./**/*.@(css|vue)\" --cache --fix --ignore-path ./.gitignore",
		"postinstall": "nuxt prepare && pnpm run generate:noske-api",
		"preinstall": "npx only-allow pnpm",
		"prepare": "is-in-ci || lefthook install",
		"start": "nuxt preview --dotenv local.env",
		"test": "exit 0",
		"test:ct": "playwright test -c playwright-ct.config.ts",
		"test:e2e": "playwright test",
		"test:e2e:codegen": "playwright codegen",
		"test:e2e:install": "playwright install --with-deps",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:update-snapshots": "playwright test --update-snapshots",
		"types:check": "nuxt typecheck",
		"validate": "run-p format:check lint:check types:check test test:e2e",
		"validate:noske-bonito": "node scripts/validate-noske-bonito.ts",
		"validate:noske-paths": "node scripts/validate-noske-path-translation.ts"
	},
	"dependencies": {
		"@acdh-oeaw/lib": "^0.3.7",
		"@acdh-oeaw/style-variants": "^0.1.0",
		"@fontsource-variable/inter": "^5.2.8",
		"@iconify-json/lucide": "^1.2.105",
		"@iconify-json/simple-icons": "^1.2.80",
		"@nuxt/fonts": "^0.14.0",
		"@nuxt/icon": "^2.2.1",
		"@nuxt/image": "^2.0.0",
		"@nuxt/scripts": "^1.0.5",
		"@nuxtjs/color-mode": "^4.0.0",
		"@nuxtjs/i18n": "^10.3.0",
		"@pinia/nuxt": "^0.11.3",
		"@tanstack/vue-form": "^1.0.0",
		"@tanstack/vue-query": "^5.71.5",
		"@tanstack/vue-table": "^8.21.2",
		"@unovis/ts": "^1.5.1",
		"@unovis/vue": "^1.5.1",
		"@vee-validate/zod": "^4.15.0",
		"@vueuse/core": "^14.3.0",
		"@vueuse/nuxt": "^14.3.0",
		"bcryptjs": "^3.0.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"d3-cloud": "^1.2.9",
		"embla-carousel-vue": "^8.5.2",
		"fast-glob": "^3.3.3",
		"highcharts": "^12.5.0",
		"highcharts-vue": "^2.0.1",
		"jose": "^6.0.10",
		"lucide-vue-next": "^1.0.0",
		"mongoose": "^9.6.1",
		"nuxt": "^4.4.6",
		"nuxt-mongoose": "^1.0.6",
		"openapi-fetch": "^0.13.5",
		"pinia": "^3.0.4",
		"pinia-plugin-persistedstate": "^4.2.0",
		"pino-http": "^11.0.0",
		"reka-ui": "^2.1.0",
		"satori": "^0.26.0",
		"shadcn-nuxt": "0.11.3",
		"sharp": "^0.34.5",
		"tailwind-merge": "^3.5.0",
		"valibot": "^1.3.1",
		"vaul-vue": "^0.2.1",
		"vee-validate": "^4.15.0",
		"vue": "^3.5.33",
		"vue-i18n": "^11.4.0",
		"vue-router": "^5.0.6",
		"vue-sonner": "^1.3.0",
		"xlsx": "^0.18.5",
		"zod": "^3.24.2"
	},
	"devDependencies": {
		"@acdh-oeaw/stylelint-config": "^3.0.3",
		"@acdh-oeaw/tsconfig": "^1.5.1",
		"@dotenvx/dotenvx": "^1.64.0",
		"@nuxt/devtools": "^3.2.4",
		"@nuxt/hints": "1.0.3",
		"@nuxt/kit": "^4.4.6",
		"@nuxt/test-utils": "^4.0.3",
		"@playwright/experimental-ct-vue": "^1.60.0",
		"@playwright/test": "^1.59.1",
		"@tailwindcss/postcss": "^4.3.0",
		"@tailwindcss/typography": "^0.5.19",
		"@types/d3-cloud": "^1.2.9",
		"@types/node": "^24.12.2",
		"@vitejs/plugin-vue": "^6.0.7",
		"@vue/compiler-dom": "^3.5.34",
		"axe-core": "^4.11.4",
		"axe-playwright": "^2.2.2",
		"eslint-plugin-better-tailwindcss": "^4.5.0",
		"eslint-plugin-playwright": "^2.10.2",
		"is-in-ci": "^2.0.0",
		"lefthook": "^2.1.6",
		"npm-run-all2": "^8.0.4",
		"openapi-typescript": "^7.6.1",
		"oxfmt": "^0.47.0",
		"oxlint": "^1.60.0",
		"oxlint-tsgolint": "^0.22.1",
		"postcss": "^8.5.13",
		"schema-dts": "^2.0.0",
		"shadcn-vue": "^2.4.3",
		"stylelint": "^17.9.1",
		"tailwindcss": "^4.2.4",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^7.3.2",
		"vue-tsc": "^3.2.7"
	},
	"browserslist": {
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		],
		"production": [
			">=0.75%",
			"not dead",
			"not op_mini all"
		]
	},
	"stylelint": {
		"extends": "@acdh-oeaw/stylelint-config"
	},
	"engines": {
		"node": "24.x"
	},
	"packageManager": "pnpm@11.0.4"
}
