{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": ["./.nuxt/tsconfig.json", "@acdh-oeaw/tsconfig"],
	"include": [
		".nuxt/**/*.d.ts",
		"app/**/*.d.ts",
		"app/**/*.ts",
		"app/**/*.vue",
		"eslint.config.js",
		"nuxt.config.ts",
		"tailwind.config.ts",
		"types/**/*.d.ts"
	],
	"exclude": ["server/**", "e2e/**", "node_modules/**", ".output/**"]
}
