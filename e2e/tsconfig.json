{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"paths": {
			"@/*": ["../app/*"],
			"~/*": ["../*"]
		},
		"types": ["node", "@playwright/test"]
	},
	"include": ["./**/*.ts", "../app/types/**/*.d.ts", "../types/**/*.d.ts"],
	"exclude": ["../node_modules/**", "../.output/**"]
}
