{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"baseUrl": "..",
		"paths": {
			"@/*": ["./app/*"],
			"~/*": ["./*"]
